{ config, pkgs, inputs, lib, ... }:

{
  # --- Core System & Nix Settings ---
  imports = [
    # This file is automatically generated by NixOS to describe the hardware.
    # It should not be edited manually.
    ./hardware-configuration.nix
  ];

  # Enables Flakes and the modern nix command-line tool, which are required for this setup.
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  
  # Allows the installation of proprietary software, such as the NVIDIA drivers.
  nixpkgs.config.allowUnfree = true;

  # Defines the "database schema" version for the system's stateful data.
  # It is NOT the version of NixOS currently running. Changing this value 
  # after the initial installation can break things (like database formats or 
  # default file locations). It must be left exactly as it was during the first installation.
  system.stateVersion = "25.11"; 


  # --- Bootloader & Kernel ---
  
  # Uses systemd-boot instead of GRUB. It is faster, simpler, 
  # and perfectly suited for modern UEFI systems.
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  # Forces the AMD GPU module to load during the initial ramdisk phase.
  # This ensures the display initializes as early as possible during the boot process.
  boot.initrd.kernelModules = [ "amdgpu" ];
  
  # Loads the i2c-dev module required by ddcutil to control 
  # monitor brightness directly from the software.
  boot.kernelModules = [ "i2c-dev" ];


  # --- Hardware & Drivers ---
  
  # Enables OpenGL/Vulkan support for the graphics cards.
  hardware.graphics.enable = true;
  
  # Enables the I2C bus hardware to allow communication with the monitors.
  hardware.i2c.enable = true;

  # Configures X11/Wayland to use both NVIDIA and AMD drivers for the dual-GPU setup.
  services.xserver.videoDrivers = ["nvidia" "amdgpu"];

  hardware.nvidia = {
    # Modesetting is strictly required for Wayland (Hyprland) to work with NVIDIA.
    modesetting.enable = true;
    
    # Uses the closed-source proprietary drivers.
    # Note: For very modern Turing+ cards, this might be set to `true` 
    # in the future to use the newer open-source kernel modules.
    open = false;
    
    # Provides the 'nvidia-settings' GUI tool for configuration.
    nvidiaSettings = true;
    
    # Uses the stable driver branch to avoid breaking the display setup on updates.
    package = config.boot.kernelPackages.nvidiaPackages.stable;
  };


  # --- File Systems & Storage ---
  
  # Automatically mounts removable drives (like USB sticks) when plugged in.
  services.udisks2.enable = true;

  # Dedicated backup drive.
  fileSystems."/mnt/backup-disk" = {
    device = "/dev/disk/by-uuid/F6DA6DEADA6DA817"; 
    fsType = "ntfs"; 
    options = [ 
      "users"     # Allows normal users to interact with the drive without sudo.
      "nofail"    # CRITICAL: Prevents a kernel panic if the drive is disconnected during boot.
      "noatime"   # Disables writing access times to the disk, prolonging its lifespan and speeding up reads.
    ];
  };


  # --- Networking ---
  
  networking.hostName = "nixos";
  
  # NetworkManager is the most robust way to handle both Ethernet and Wi-Fi connections.
  networking.networkmanager.enable = true;


  # --- Time, Locale & Keymaps ---
  
  time.timeZone = "Europe/Paris";

  i18n.defaultLocale = "en_US.UTF-8";
  
  # Keeps the system language in English to make troubleshooting easier, 
  # but sets specific formats (currency, dates, measurements) to French.
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "fr_FR.UTF-8";
    LC_IDENTIFICATION = "fr_FR.UTF-8";
    LC_MEASUREMENT = "fr_FR.UTF-8";
    LC_MONETARY = "fr_FR.UTF-8";
    LC_NAME = "fr_FR.UTF-8";
    LC_NUMERIC = "fr_FR.UTF-8";
    LC_PAPER = "fr_FR.UTF-8";
    LC_TELEPHONE = "fr_FR.UTF-8";
    LC_TIME = "fr_FR.UTF-8";
  };

  # Configures a French AZERTY layout for both the graphical session and the TTY console.
  services.xserver.xkb = {
    layout = "fr";
    variant = "";
  };
  console.keyMap = "fr";


  # --- User Configuration ---
  
  # Zsh must be enabled system-wide before it can be set as the default shell.
  programs.zsh.enable = true;

  users.users.ben = {
    isNormalUser = true;
    description = "ben";
    shell = pkgs.zsh;
    # 'wheel' grants sudo privileges.
    # 'networkmanager' allows changing network settings without a password.
    # 'i2c' grants permission to use ddcutil without root.
    extraGroups = [ "networkmanager" "wheel" "i2c" ];
    
    # Kept empty since Home Manager is used. 
    # User-specific packages belong in home.nix.
    packages = with pkgs; [];
  };


  # --- Desktop Environment & Display ---
  
  # Polkit is required for GUI applications to request elevated privileges 
  # (like GParted asking for a password via a popup).
  security.polkit.enable = true;

  # Forces certain applications (like Electron apps) to run natively 
  # on Wayland instead of relying on XWayland, improving crispness and performance.
  environment.sessionVariables = {
    NIXOS_OZONE_WL = "1";
    XDG_SESSION_TYPE = "wayland";
  };

  # Pulls Hyprland directly from its flake input to always get the latest features.
  programs.hyprland = {
    enable = true;
    package = inputs.hyprland.packages.${pkgs.stdenv.hostPlatform.system}.hyprland;
  };

  # Uses Ly as the Display Manager. It is a very lightweight, terminal-based 
  # login screen that works perfectly with Wayland compositors.
  services.displayManager.ly = {
    enable = true;
    settings = {
      animation = "none";      # Keeps the login screen minimal and distraction-free.
      clear_password = true;   # Instantly clears the field if the password is mistyped.
      numlock = true;          # Essential to type the PIN/password immediately.
      vi_mode = false;         # Disables vi mode to use standard arrow keys for navigation.
    };
  };


  # --- Audio & Sound (PipeWire) ---
  
  # Gives PipeWire real-time scheduling priority, preventing audio stuttering 
  # when the CPU is under heavy load.
  security.rtkit.enable = true; 
  
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    # PulseAudio emulation ensures older or specific apps (like Firefox) 
    # can output sound transparently through PipeWire.
    pulse.enable = true; 

    # Enforces a wide range of sample rates to ensure low-latency audio 
    # and prevent sample-rate conversion artifacts.
    extraConfig = {
      pipewire."92-low-latency" = {
        "context.properties" = {
          "default.clock.allowed-rates" = [ 44100 48000 88200 96000 176400 192000 ];
        };
      };
      pipewire-pulse."92-low-latency" = {
        "context.properties" = {
          "default.clock.allowed-rates" = [ 44100 48000 88200 96000 176400 192000 ];
        };
      };
    };
  };


  # --- System Packages & Programs ---
  
  # Dconf is a low-level configuration system used by GTK apps. 
  # Enabling it here ensures GTK themes and settings (often set via Home Manager) apply correctly.
  programs.dconf.enable = true;

  # Core tools required globally on the system, even for the root user. 
  # Personal GUI apps should go in Home Manager.
  environment.systemPackages = with pkgs; [
    git
    neovim 
    udisks2     # Required for the udisks2 service to function
    ddcutil     # Tool to control monitor brightness/contrast
    rclone      # Cloud storage syncing
    icloudpd    # iCloud photo downloader
  ];

}