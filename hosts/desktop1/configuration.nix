{ config, pkgs, inputs, lib, ... }:

{
  # ====================================================================
  # --- Core System & Nix Settings ---
  # ====================================================================
    
  imports = [
    # This file is automatically generated by NixOS to describe the hardware.
    # It should not be edited manually.
    ./hardware-configuration.nix

    ./modules/virtualization-configuration.nix

    ../common-configuration.nix
  ];

  # Defines the "database schema" version for the system's stateful data.
  # It is NOT the version of NixOS currently running. Changing this value 
  # after the initial installation can break things (like database formats or 
  # default file locations). It must be left exactly as it was during the first installation.
  system.stateVersion = "25.11"; 

  networking.hostName = "desktop1-nixos";

  # --- Hardware & Drivers ---
  
  # Enables OpenGL/Vulkan support for the graphics cards.
  hardware.graphics.enable = true;
  
  # Enables the I2C bus hardware to allow communication with the monitors.
  hardware.i2c.enable = true;

  # Configures X11/Wayland to use both NVIDIA and AMD drivers for the dual-GPU setup.
  services.xserver.videoDrivers = ["amdgpu"];

  # --- Wake On Lan ---

  systemd.network.links."10-wol" = {
    matchConfig.MACAddress = "2c:f0:5d:aa:98:13";
    linkConfig.WakeOnLan = "magic";
  };


  # ====================================================================
  # --- User configuration ---
  # ====================================================================

  users.users.ben = {
    isNormalUser = true;
    shell = pkgs.zsh;
    # 'wheel' grants sudo privileges.
    # 'networkmanager' allows changing network settings without a password.
    # 'i2c' grants permission to use ddcutil without root.
    extraGroups = [ "networkmanager" "wheel" "i2c" "libvirtd" "kvm"];

    openssh.authorizedKeys.keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM66hTYZVuVKYEHQjebXBpKmgsHqSZF9fHBDs9r4igY+ laptop1"
    ];
    
    # Kept empty since Home Manager is used. 
    # User-specific packages belong in home.nix.
    packages = with pkgs; [];
  };


  services.openssh = {
    enable = true;
    settings = {
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
      PermitRootLogin = "no";
    };
  };


  # ====================================================================
  # --- System Packages & Programs ---
  # ====================================================================

  # Core tools required globally on the system, even for the root user. 
  # Personal GUI apps should go in Home Manager.
  environment.systemPackages = with pkgs; [
    ddcutil     # Tool to control monitor brightness/contrast
  ];
}