{
    // --- Global Configuration ---
    
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 5,
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    
    // --- Module Positioning ---
    
    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [
        "custom/window"
    ],
    "modules-right": [
        "custom/uair",
        "custom/vpn",
        "custom/airplane",
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/brightness",
        "hyprland/language",
        "battery",
        "clock"
    ],

    // --- Left Modules ---
    
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{id}"
    },
    
    "mpris": {
        "format": "{player_icon} <i>{title} - {artist}</i>",
        "format-paused": "{status_icon} <i>{title} - {artist}</i>",
        "player-icons": {
            "default": ""
        },
        "status-icons": {
            "paused": ""
        },
        "max-length": 50,
        "tooltip": false
    },

    // --- Center Modules ---
    
    "custom/window": {
        "format": "{}",
        "return-type": "json",
        // Calls the custom Nix script package
        "exec": "window-names",
        "max-length": 50,
        "separate-outputs": false
    },

    // --- Right Modules ---

    "custom/uair": {
        "exec": "time-tracker-display",
        "return-type": "text",
        "on-click": "time-tracker",
        "tooltip": false
    },

    "custom/vpn": {
        "exec": "ip a show tailscale0 | grep -q 'inet 100.' && echo '(VPN)' || echo ''",
        "return-type": "text",
        "tooltip": false,
        "interval": 3
    },
    
    "custom/airplane": {
        "format": "{}",
        // Calls the custom Nix script package
        "exec": "network-status",
        "tooltip": false,
        "on-click": "kitty -e nmtui"
    },
    
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip": false,
        "on-click": "kitty -e nmtui"
    },
    
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip": false,
        "on-click": "blueman-manager"
    },
    
    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " Muted",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.5",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },
    
    "custom/brightness": {
        "format": " {percentage}%",
        "return-type": "json",
        // Calls the custom Nix script package with the "get" argument
        "exec": "brightness get",
        "signal": 8,
        "on-scroll-up": "brightness up",
        "on-scroll-down": "brightness down",
        "tooltip": false
    },
    
    "hyprland/language": {
        "format": " {short}",
        "on-click": "hyprctl switchxkblayout all next"
    },

    "battery": {
        "states": {
            "warning": 10,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "   {capacity}%",
        "format-plugged": "   {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip": false
    },
    
    "clock": {
        "format": "{:%H:%M  |  %d-%b}",
        "tooltip": false
    }
}